generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id       String @id
  username String

  level   Int @default(1)
  xp      Int @default(0)
  totalXp Int @default(0)

  streak       Int      @default(0)
  lastStreakAt DateTime @default(now())

  servers Server[]

  createdAt         DateTime @default(now())
  customProfileHtml String?
}

model Server {
  id String

  userId String

  user User @relation(fields: [userId], references: [id])

  level   Int @default(1)
  xp      Int @default(0)
  totalXp Int @default(0)

  streak       Int      @default(0)
  lastStreakAt DateTime @default(now())

  @@unique([id, userId])
}

model Warning {
  id       Int    @id @default(autoincrement())
  userId   String
  serverId String

  warnedByUserId String

  reason    String
  createdAt DateTime @default(now())

  @@index([userId, serverId])
}
